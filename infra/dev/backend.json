{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "FasoEcole Fargate backend service (dev or prod)",
  "Parameters": {
    "ImageUri": {
      "Type": "String"
    },
    "SmtpHost": {
      "Type": "String",
      "Default": "smtp.gmail.com"
    },
    "MailFrom": {
      "Type": "String",
      "Default": ""
    },
    "DesiredCount": {
      "Type": "Number",
      "Default": 1,
      "AllowedValues": [
        0,
        1
      ]
    },
    "TargetEnvironment": {
      "Type": "String",
      "Default": "dev",
      "AllowedValues": [
        "dev",
        "prod"
      ]
    }
  },
  "Resources": {
    "ExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "fasoecole-${TargetEnvironment}-task-execution"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Policies": [
          {
            "PolicyName": "ApplicationSecrets",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": "secretsmanager:GetSecretValue",
                  "Resource": [
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "fasoecole-${TargetEnvironment}-DatabaseSecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "fasoecole-${TargetEnvironment}-JwtSecret"
                      }
                    },
                    {
                      "Fn::ImportValue": {
                        "Fn::Sub": "fasoecole-${TargetEnvironment}-SmtpSecret"
                      }
                    }
                  ]
                }
              ]
            }
          }
        ]
      }
    },
    "TaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Sub": "fasoecole-${TargetEnvironment}-task"
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "Task": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": {
          "Fn::Sub": "fasoecole-${TargetEnvironment}-bff"
        },
        "Cpu": "512",
        "Memory": "2048",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": [
          "FARGATE"
        ],
        "RuntimePlatform": {
          "CpuArchitecture": "X86_64",
          "OperatingSystemFamily": "LINUX"
        },
        "ExecutionRoleArn": {
          "Fn::GetAtt": [
            "ExecutionRole",
            "Arn"
          ]
        },
        "TaskRoleArn": {
          "Fn::GetAtt": [
            "TaskRole",
            "Arn"
          ]
        },
        "ContainerDefinitions": [
          {
            "Name": "bff",
            "Image": {
              "Ref": "ImageUri"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": 8080
              }
            ],
            "Environment": [
              {
                "Name": "SPRING_PROFILES_ACTIVE",
                "Value": {
                  "Ref": "TargetEnvironment"
                }
              },
              {
                "Name": "DB_HOST",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "fasoecole-${TargetEnvironment}-DatabaseHost"
                  }
                }
              },
              {
                "Name": "DB_PORT",
                "Value": "5432"
              },
              {
                "Name": "DB_NAME",
                "Value": "fasoecoleBD"
              },
              {
                "Name": "CORS_ALLOWED_ORIGINS",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "fasoecole-${TargetEnvironment}-FrontendUrl"
                  }
                }
              },
              {
                "Name": "FRONTEND_BASE_URL",
                "Value": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "fasoecole-${TargetEnvironment}-FrontendUrl"
                  }
                }
              },
              {
                "Name": "SMTP_HOST",
                "Value": {
                  "Ref": "SmtpHost"
                }
              },
              {
                "Name": "MAIL_FROM",
                "Value": {
                  "Ref": "MailFrom"
                }
              },
              {
                "Name": "JAVA_TOOL_OPTIONS",
                "Value": "-XX:MaxRAMPercentage=65.0"
              }
            ],
            "Secrets": [
              {
                "Name": "DB_USER",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "fasoecole-${TargetEnvironment}-DatabaseSecret"
                        }
                      },
                      ":username::"
                    ]
                  ]
                }
              },
              {
                "Name": "DB_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "fasoecole-${TargetEnvironment}-DatabaseSecret"
                        }
                      },
                      ":password::"
                    ]
                  ]
                }
              },
              {
                "Name": "JWT_SECRET",
                "ValueFrom": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "fasoecole-${TargetEnvironment}-JwtSecret"
                  }
                }
              },
              {
                "Name": "SMTP_USERNAME",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "fasoecole-${TargetEnvironment}-SmtpSecret"
                        }
                      },
                      ":username::"
                    ]
                  ]
                }
              },
              {
                "Name": "SMTP_PASSWORD",
                "ValueFrom": {
                  "Fn::Join": [
                    "",
                    [
                      {
                        "Fn::ImportValue": {
                          "Fn::Sub": "fasoecole-${TargetEnvironment}-SmtpSecret"
                        }
                      },
                      ":password::"
                    ]
                  ]
                }
              }
            ],
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": {
                  "Fn::ImportValue": {
                    "Fn::Sub": "fasoecole-${TargetEnvironment}-LogGroup"
                  }
                },
                "awslogs-region": {
                  "Ref": "AWS::Region"
                },
                "awslogs-stream-prefix": "bff"
              }
            }
          }
        ]
      }
    },
    "Service": {
      "Type": "AWS::ECS::Service",
      "Properties": {
        "ServiceName": {
          "Fn::Sub": "fasoecole-${TargetEnvironment}-bff"
        },
        "Cluster": {
          "Fn::ImportValue": {
            "Fn::Sub": "fasoecole-${TargetEnvironment}-Cluster"
          }
        },
        "TaskDefinition": {
          "Ref": "Task"
        },
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "DesiredCount": {
          "Ref": "DesiredCount"
        },
        "HealthCheckGracePeriodSeconds": 180,
        "DeploymentConfiguration": {
          "MinimumHealthyPercent": 100,
          "MaximumPercent": 200,
          "DeploymentCircuitBreaker": {
            "Enable": true,
            "Rollback": true
          }
        },
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "ENABLED",
            "Subnets": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "fasoecole-${TargetEnvironment}-Public0"
                }
              },
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "fasoecole-${TargetEnvironment}-Public1"
                }
              }
            ],
            "SecurityGroups": [
              {
                "Fn::ImportValue": {
                  "Fn::Sub": "fasoecole-${TargetEnvironment}-TaskSecurity"
                }
              }
            ]
          }
        },
        "LoadBalancers": [
          {
            "ContainerName": "bff",
            "ContainerPort": 8080,
            "TargetGroupArn": {
              "Fn::ImportValue": {
                "Fn::Sub": "fasoecole-${TargetEnvironment}-Target"
              }
            }
          }
        ]
      }
    }
  },
  "Outputs": {}
}
